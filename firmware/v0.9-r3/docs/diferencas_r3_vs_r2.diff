+  Serial.printf(",categoria_fluxo08=%d,categoria=%d,nivel_sem_regra=%d,nivel=%d,limitou=%d,motivo=%s\n",
+                g.categoria_fluxo08,g.viavel?g.categoria:-1,g.nivel_sem_regra,g.viavel?g.nivel:-1,g.limitou()?1:0,g.nome_motivo());
